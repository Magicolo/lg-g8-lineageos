<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.g8rom.smoke">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="37" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <application android:label="G8 ROM compatibility checks" android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".SmokeActivity" android:exported="true"
            android:resizeableActivity="true" android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation" />
    </application>
</manifest>
